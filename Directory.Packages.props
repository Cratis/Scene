<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <!-- Cratis -->
    <PackageVersion Include="Cratis.Chronicle" Version="19.156.2" />
    <!-- Pre-release carrying free screens, shape/uses screen/provisions and the resolved design system; the released version replaces it. -->
    <PackageVersion Include="Cratis.Screenplay" Version="6.99.0-scenedesign.2" />
    <!-- Analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.312" />
    <!-- Testing & Specifications -->
    <PackageVersion Include="Cratis.Specifications.XUnit.v3" Version="5.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>