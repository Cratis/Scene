{
  "description": "Shared navigation diagnostic corpus. Both the TypeScript engine (engine/for_diagnoseNavigation) and the C# engine (Engine.Specs/for_NavigationDiagnostics) diagnose every graph and must report exactly these codes, entries and messages, in this order.",
  "cases": [
    {
      "name": "shell, master detail and dialog destinations that fit together",
      "graph": {
        "layouts": [{ "name": "AppShell", "slots": [{ "name": "body" }, { "name": "content", "routed": true }] }],
        "screenTemplates": [
          { "name": "MasterDetail", "slots": [{ "name": "detail", "routed": true, "accepts": ["Detail", "Form"] }], "metadata": { "type": "Workspace" } },
          { "name": "DetailPane", "slots": [], "metadata": { "type": "Detail" } }
        ],
        "dialogTemplates": [{ "name": "ConfirmDialog", "slots": [] }],
        "screens": [
          { "name": "Invoices", "layout": "AppShell", "screenTemplate": "MasterDetail", "slotContent": {}, "forms": [], "contributions": [] },
          { "name": "InvoiceDetails", "layout": "AppShell", "screenTemplate": "DetailPane", "slotContent": {}, "forms": [], "contributions": [] }
        ],
        "entries": [
          { "id": "nav.invoices", "destination": { "screen": "Invoices", "slot": "content", "route": "invoices" } },
          { "id": "toolbar.invoices", "destination": { "screen": "Invoices", "slot": "content", "route": "/invoices/" } },
          { "id": "row.details", "destination": { "screen": "InvoiceDetails", "slot": "detail", "route": "invoices/{id}" } },
          { "id": "toolbar.confirm", "destination": { "kind": "dialog", "dialog": "ConfirmDialog" } },
          { "id": "help", "destination": { "kind": "external", "route": "invoices" } }
        ]
      },
      "expectedDiagnostics": []
    },
    {
      "name": "unknown catalogs are not reported as unavailable",
      "graph": {
        "entries": [
          { "id": "nav.reports", "destination": { "screen": "Reports" } },
          { "id": "nav.slice", "destination": { "module": "Sales", "feature": "Invoices", "slice": "Register" } },
          { "id": "open.dialog", "destination": { "dialog": "AnyDialog" } }
        ]
      },
      "expectedDiagnostics": []
    },
    {
      "name": "duplicate authored routes",
      "graph": {
        "entries": [
          { "id": "invoice", "destination": { "screen": "InvoiceDetails", "route": "invoices/{id}" } },
          { "id": "credit-note", "destination": { "screen": "CreditNoteDetails", "route": "invoices/{id}" } },
          { "id": "list", "destination": { "screen": "Invoices", "slot": "content", "route": "invoices" } },
          { "id": "list-again", "destination": { "screen": "Invoices", "slot": "content", "route": " invoices " } },
          { "id": "list-in-detail", "destination": { "screen": "Invoices", "slot": "detail", "route": "invoices" } },
          { "id": "derived", "destination": { "module": "Sales", "feature": "Invoices" } },
          { "id": "also-derived", "destination": { "module": "Sales", "feature": "CreditNotes" } }
        ]
      },
      "expectedDiagnostics": [
        { "code": "duplicateRoute", "entry": "credit-note", "message": "Route 'invoices/{id}' is used by destinations 'invoice' and 'credit-note', which open different targets." },
        { "code": "missingSlot", "entry": "list", "message": "Destination 'list' targets missing slot 'content'." },
        { "code": "missingSlot", "entry": "list-again", "message": "Destination 'list-again' targets missing slot 'content'." },
        { "code": "missingSlot", "entry": "list-in-detail", "message": "Destination 'list-in-detail' targets missing slot 'detail'." },
        { "code": "duplicateRoute", "entry": "list-in-detail", "message": "Route 'invoices' is used by destinations 'list' and 'list-in-detail', which open different targets." }
      ]
    },
    {
      "name": "duplicate slots across a layout and a nested template",
      "graph": {
        "layouts": [{ "name": "AppShell", "slots": [{ "name": "content", "routed": true }] }],
        "screenTemplates": [{ "name": "Workspace", "slots": [{ "name": "content", "routed": true }, { "name": "detail", "routed": true }] }],
        "entries": [{ "id": "nav.home", "destination": { "screen": "Home", "slot": "content" } }]
      },
      "expectedDiagnostics": [
        { "code": "duplicateSlot", "message": "Slot 'content' is declared by both 'AppShell' and 'Workspace'; destinations cannot tell them apart." }
      ]
    },
    {
      "name": "missing slot",
      "graph": {
        "layouts": [{ "name": "AppShell", "slots": [{ "name": "content", "routed": true }] }],
        "entries": [{ "id": "nav.reports", "destination": { "screen": "Reports", "slot": "sidebar" } }]
      },
      "expectedDiagnostics": [
        { "code": "missingSlot", "entry": "nav.reports", "message": "Destination 'nav.reports' targets missing slot 'sidebar'." }
      ]
    },
    {
      "name": "incompatible slots",
      "graph": {
        "layouts": [
          { "name": "AppShell", "slots": [{ "name": "content", "routed": true }] },
          { "name": "FullPage", "slots": [] }
        ],
        "screenTemplates": [
          { "name": "MasterDetail", "slots": [{ "name": "detail", "routed": true, "accepts": ["Detail"] }], "metadata": { "type": "Workspace" } },
          { "name": "EditForm", "slots": [], "metadata": { "type": "Form" } },
          { "name": "Plain", "slots": [] }
        ],
        "dialogTemplates": [{ "name": "ConfirmDialog", "slots": [] }],
        "screens": [
          { "name": "Invoices", "layout": "AppShell", "screenTemplate": "MasterDetail", "slotContent": {}, "forms": [], "contributions": [] },
          { "name": "EditInvoice", "layout": "AppShell", "screenTemplate": "EditForm", "slotContent": {}, "forms": [], "contributions": [] },
          { "name": "Notes", "layout": "AppShell", "screenTemplate": "Plain", "slotContent": {}, "forms": [], "contributions": [] },
          { "name": "SignIn", "layout": "FullPage", "slotContent": {}, "forms": [], "contributions": [] }
        ],
        "entries": [
          { "id": "edit", "destination": { "screen": "EditInvoice", "slot": "detail" } },
          { "id": "notes", "destination": { "screen": "Notes", "slot": "detail" } },
          { "id": "sign-in", "destination": { "screen": "SignIn", "slot": "content" } },
          { "id": "confirm", "destination": { "kind": "dialog", "dialog": "ConfirmDialog", "slot": "content" } },
          { "id": "docs", "destination": { "kind": "external", "route": "https://docs.example.com", "slot": "content" } }
        ]
      },
      "expectedDiagnostics": [
        { "code": "incompatibleSlot", "entry": "edit", "message": "Slot 'detail' accepts Detail screens, but destination 'edit' places 'EditInvoice' of type 'Form'." },
        { "code": "incompatibleSlot", "entry": "notes", "message": "Slot 'detail' accepts Detail screens, but destination 'notes' places 'Notes' of type 'untyped'." },
        { "code": "incompatibleSlot", "entry": "sign-in", "message": "Slot 'content' belongs to layout 'AppShell', but destination 'sign-in' places 'SignIn', which renders in layout 'FullPage'." },
        { "code": "incompatibleSlot", "entry": "confirm", "message": "Destination 'confirm' opens a dialog but names slot 'content'; only slot destinations render in slots." },
        { "code": "incompatibleSlot", "entry": "docs", "message": "Destination 'docs' opens an external target but names slot 'content'; only slot destinations render in slots." }
      ]
    },
    {
      "name": "a screen placed in a slot its own template owns",
      "graph": {
        "screenTemplates": [{ "name": "MasterDetail", "slots": [{ "name": "detail", "routed": true }] }],
        "screens": [
          { "name": "Invoices", "layout": "AppShell", "screenTemplate": "MasterDetail", "slotContent": {}, "forms": [], "contributions": [] }
        ],
        "entries": [{ "id": "row.open", "destination": { "screen": "Invoices", "slot": "detail" } }]
      },
      "expectedDiagnostics": [
        { "code": "navigationCycle", "message": "Navigation cycle Invoices -> Invoices: each screen is placed in a slot owned by the next, so composition never terminates." }
      ]
    },
    {
      "name": "screens hosting each other through nested slots",
      "graph": {
        "screenTemplates": [
          { "name": "CustomerWorkspace", "slots": [{ "name": "customer.detail", "routed": true }] },
          { "name": "OrderWorkspace", "slots": [{ "name": "order.detail", "routed": true }] },
          { "name": "ProductWorkspace", "slots": [{ "name": "product.detail", "routed": true }] }
        ],
        "screens": [
          { "name": "Customers", "layout": "AppShell", "screenTemplate": "CustomerWorkspace", "slotContent": {}, "forms": [], "contributions": [] },
          { "name": "Orders", "layout": "AppShell", "screenTemplate": "OrderWorkspace", "slotContent": {}, "forms": [], "contributions": [] },
          { "name": "Products", "layout": "AppShell", "screenTemplate": "ProductWorkspace", "slotContent": {}, "forms": [], "contributions": [] }
        ],
        "entries": [
          { "id": "customer.orders", "destination": { "screen": "Orders", "slot": "customer.detail" } },
          { "id": "order.products", "destination": { "screen": "Products", "slot": "order.detail" } },
          { "id": "product.customers", "destination": { "screen": "Customers", "slot": "product.detail" } }
        ]
      },
      "expectedDiagnostics": [
        { "code": "navigationCycle", "message": "Navigation cycle Customers -> Products -> Orders -> Customers: each screen is placed in a slot owned by the next, so composition never terminates." }
      ]
    },
    {
      "name": "unavailable targets",
      "graph": {
        "dialogTemplates": [{ "name": "ConfirmDialog", "slots": [] }],
        "screens": [
          { "name": "Invoices", "layout": "AppShell", "slotContent": {}, "forms": [], "contributions": [] }
        ],
        "entries": [
          { "id": "nav.reports", "destination": { "screen": "Reports" } },
          { "id": "delete", "destination": { "kind": "dialog", "dialog": "DeleteDialog" } },
          { "id": "unnamed-dialog", "destination": { "kind": "dialog", "route": "confirm" } },
          { "id": "empty", "destination": { "slot": "content" } },
          { "destination": { "feature": "Invoices" } }
        ]
      },
      "expectedDiagnostics": [
        { "code": "unavailableTarget", "entry": "nav.reports", "message": "Destination 'nav.reports' opens screen 'Reports', which does not exist." },
        { "code": "unavailableTarget", "entry": "delete", "message": "Destination 'delete' opens dialog 'DeleteDialog', which no dialog template provides." },
        { "code": "unavailableTarget", "entry": "unnamed-dialog", "message": "Dialog destination 'unnamed-dialog' names no dialog." },
        { "code": "unavailableTarget", "entry": "empty", "message": "Destination 'empty' names no screen, stable identity, route or dialog." },
        { "code": "unavailableTarget", "entry": "#5", "message": "Destination '#5' names no screen, stable identity, route or dialog." }
      ]
    },
    {
      "name": "navigation regions that fit the application structure",
      "graph": {"entries":[],"structure":{"modules":[{"id":"sales","name":"Sales","features":[{"id":"orders","name":"Orders","features":[],"slices":[]}]},{"id":"support","name":"Support","features":[{"id":"tickets","name":"Tickets","features":[],"slices":[]}]},{"id":"empty","name":"Empty","features":[]}]},"navigation":{"application":{"regions":[{"region":"topbar","items":[{"id":"sales","title":"sales","target":{"module":"sales"}},{"id":"support","title":"support","target":{"module":"support"}}]}]},"modules":[{"module":"sales","regions":[{"region":"topbar","mode":"extend","items":[{"id":"orders","title":"orders","target":{"module":"sales"}}]}]}]}},
      "expectedDiagnostics": []
    },
    {
      "name": "navigation regions with missing targets, unknown slots, duplicate ids and out-of-scope targets",
      "graph": {"entries":[],"structure":{"modules":[{"id":"sales","name":"Sales","features":[{"id":"orders","name":"Orders","features":[],"slices":[]}]},{"id":"support","name":"Support","features":[{"id":"tickets","name":"Tickets","features":[],"slices":[]}]},{"id":"empty","name":"Empty","features":[]}]},"slots":["content"],"navigation":{"application":{"regions":[{"region":"topbar","items":[{"id":"missing","title":"missing","target":{"module":"billing"}},{"id":"nofeatures","title":"nofeatures","target":{"module":"empty"}},{"id":"drawer","title":"drawer","target":{"module":"sales"},"slot":"drawer"},{"id":"drawer","title":"drawer","target":{"module":"sales"}}]}]},"modules":[{"module":"support","regions":[{"region":"topbar","mode":"override","items":[{"id":"orders","title":"orders","target":{"module":"sales"}}]}]}]}},
      "expectedDiagnostics": [
        {"code": "navTargetMissing", "entry": "application:topbar:missing", "message": "Navigation item 'missing' targets module 'billing', which does not exist."},
        {"code": "navModuleWithoutFeatures", "entry": "application:topbar:nofeatures", "message": "Navigation item 'nofeatures' targets module 'empty', which has no features to go to."},
        {"code": "navSlotUnknown", "entry": "application:topbar:drawer", "message": "Navigation item 'drawer' renders into slot 'drawer', which the layout does not declare."},
        {"code": "navDuplicateId", "entry": "application:topbar:drawer", "message": "Navigation item 'drawer' is used more than once in the application topbar."},
        {"code": "navTargetOutOfScope", "entry": "support:topbar:orders", "message": "Navigation item 'orders' of module 'support' targets module 'sales'; a module's own items may only target that module."}
      ]
    }
  ]
}
