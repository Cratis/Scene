  "colorSchemeSwitch": [
    {
      "name": "light to dark moves a light theme to the dark default",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "default-blueprint"
        ],
        "theme": "Scene Default Light"
      },
      "scheme": "Dark",
      "expected": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "default-blueprint"
          ],
          "theme": "Scene Default Dark",
          "appearance": {
            "colorScheme": "Dark"
          }
        },
        "themeChanged": true,
        "message": "Theme changed to Scene Default Dark to match the dark scheme"
      }
    },
    {
      "name": "dark to light moves a dark theme to the light default",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "default-blueprint"
        ],
        "theme": "Material Dark",
        "appearance": {
          "accent": "#0a7a4b"
        }
      },
      "scheme": "Light",
      "expected": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "default-blueprint"
          ],
          "theme": "Scene Default Light",
          "appearance": {
            "accent": "#0a7a4b",
            "colorScheme": "Light"
          }
        },
        "themeChanged": true,
        "message": "Theme changed to Scene Default Light to match the light scheme"
      }
    },
    {
      "name": "the same scheme keeps the theme",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "default-blueprint"
        ],
        "theme": "Scene Default Light"
      },
      "scheme": "Light",
      "expected": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "default-blueprint"
          ],
          "theme": "Scene Default Light",
          "appearance": {
            "colorScheme": "Light"
          }
        },
        "themeChanged": false,
        "message": ""
      }
    },
    {
      "name": "no theme chosen only sets the scheme",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "default-blueprint"
        ]
      },
      "scheme": "Dark",
      "expected": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "default-blueprint"
          ],
          "appearance": {
            "colorScheme": "Dark"
          }
        },
        "themeChanged": false,
        "message": ""
      }
    },
    {
      "name": "an unknown theme is kept",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "default-blueprint"
        ],
        "theme": "Mystery"
      },
      "scheme": "Dark",
      "expected": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "default-blueprint"
          ],
          "theme": "Mystery",
          "appearance": {
            "colorScheme": "Dark"
          }
        },
        "themeChanged": false,
        "message": ""
      }
    }
  ],
  "versionRules": [
    {
      "name": "no rule follows and is up to date",
      "installed": "1.2.0",
      "latest": "1.2.0",
      "expected": {
        "choices": [
          {
            "kind": "follow",
            "label": "Follow compatible versions",
            "description": "Takes updates that ^1.2.0 allows",
            "pin": "^1.2.0"
          },
          {
            "kind": "pin",
            "label": "Pin to 1.2.0",
            "description": "Stays on exactly this version",
            "pin": "1.2.0"
          },
          {
            "kind": "latest",
            "label": "Always the latest",
            "description": "Takes every new version, including breaking ones",
            "pin": "*"
          }
        ],
        "selected": "follow",
        "status": {
          "tone": "good",
          "text": "Up to date"
        }
      }
    },
    {
      "name": "a compatible update",
      "installed": "1.2.0",
      "latest": "1.3.0",
      "expected": {
        "choices": [
          {
            "kind": "follow",
            "label": "Follow compatible versions",
            "description": "Takes updates that ^1.2.0 allows",
            "pin": "^1.2.0"
          },
          {
            "kind": "pin",
            "label": "Pin to 1.2.0",
            "description": "Stays on exactly this version",
            "pin": "1.2.0"
          },
          {
            "kind": "latest",
            "label": "Always the latest",
            "description": "Takes every new version, including breaking ones",
            "pin": "*"
          }
        ],
        "selected": "follow",
        "status": {
          "tone": "info",
          "text": "Version 1.3.0 is available and compatible"
        }
      }
    },
    {
      "name": "a breaking update is not allowed by following",
      "installed": "1.2.0",
      "latest": "2.0.0",
      "expected": {
        "choices": [
          {
            "kind": "follow",
