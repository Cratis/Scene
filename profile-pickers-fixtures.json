          },
          {
            "kind": "latest",
            "label": "Always the latest",
            "description": "Takes every new version, including breaking ones",
            "pin": "*"
          }
        ],
        "selected": "follow",
        "status": {
          "tone": "warning",
          "text": "Version 2.0.0 is available but ^1.2.0 does not allow it"
        }
      }
    },
    {
      "name": "a pin blocks an update",
      "pin": "1.2.0",
      "installed": "1.2.0",
      "latest": "1.2.1",
      "expected": {
        "choices": [
          {
            "kind": "follow",
            "label": "Follow compatible versions",
            "description": "Takes updates that ^1.2.0 allows",
            "pin": "^1.2.0"
          },
          {
            "kind": "pin",
            "label": "Pin to 1.2.0",
            "description": "Stays on exactly this version",
            "pin": "1.2.0"
          },
          {
            "kind": "latest",
            "label": "Always the latest",
            "description": "Takes every new version, including breaking ones",
            "pin": "*"
          }
        ],
        "selected": "pin",
