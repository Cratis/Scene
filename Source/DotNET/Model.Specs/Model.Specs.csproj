<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Scene.Model.Specs</AssemblyName>
        <RootNamespace>Cratis.Scene.Model</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Library specs run on net11.0 by default; CI also tests net10.0 compatibility. -->
        <OutputType>Exe</OutputType>
        <TargetFrameworks>$(SpecTargetFramework)</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Model/Model.csproj" />
    </ItemGroup>
</Project>
