{
    "name": "@cratis/scene.extensions",
    "version": "1.0.0",
    "description": "The extension component contract: the React and mount component kinds, the ExtensionContext, the use* hooks, MountedComponent, slot composition, frontend manifest types and a conformance kit every host and every extension frontend shares.",
    "homepage": "https://www.cratis.io/screenplay/",
    "keywords": [
        "cratis",
        "scene",
        "react",
        "ui",
        "extension",
        "contract",
        "low-code"
    ],
    "author": "Cratis",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Scene.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "**/*.ts",
        "**/*.tsx",
        "!**/for_*/**"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/esm/index.d.ts",
            "require": "./dist/cjs/index.js",
            "import": "./dist/esm/index.js"
        }
    },
    "scripts": {
        "prepare": "yarn g:build",
        "clean": "yarn g:clean",
        "build": "yarn g:build",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "yarn g:test",
        "ci": "yarn g:ci",
        "up": "yarn g:up"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    }
}
