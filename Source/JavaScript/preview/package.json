{
    "name": "@cratis/scene.preview",
    "version": "1.0.0",
    "description": "The preview host: renders the effective application - shell, navigation, a feature or a slice dialog - from an in-memory Scene document with sample data and a dry-run invoker, through the composition function the Stage shares.",
    "keywords": [
        "cratis",
        "scene",
        "react",
        "preview",
        "designer",
        "low-code"
    ],
    "author": "Cratis",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Scene.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "**/*.ts",
        "**/*.tsx",
        "preview.css",
        "!**/for_*/**"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/esm/index.d.ts",
            "require": "./dist/cjs/index.js",
            "import": "./dist/esm/index.js"
        },
        "./styles": "./preview.css",
        "./styles.css": "./preview.css"
    },
    "scripts": {
        "prepare": "yarn g:build",
        "clean": "yarn g:clean",
        "build": "yarn g:build",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "yarn g:test",
        "ci": "yarn g:ci",
        "up": "yarn g:up"
    },
    "dependencies": {
        "@cratis/scene.blueprint.default": "1.0.0",
        "@cratis/scene.engine": "1.0.0",
        "@cratis/scene.model": "1.0.0",
        "@cratis/scene.react": "1.0.0"
    },
    "devDependencies": {
        "@cratis/scene.blueprint.default": "1.0.0",
        "@cratis/scene.engine": "1.0.0",
        "@cratis/scene.model": "1.0.0",
        "@cratis/scene.primereact": "1.0.0",
        "@cratis/scene.react": "1.0.0",
        "@primereact/core": "11.2.0",
        "@primereact/headless": "11.2.0",
        "@primeuix/themes": "^3.0.1",
        "primeicons": "8.0.2",
        "primereact": "11.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "peerDependencies": {
        "@primereact/core": "^11.0.0",
        "@primereact/headless": "^11.0.0",
        "primeicons": "^8.0.0",
        "primereact": "^11.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    }
}
