{
    "extends": "../../../tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "dist/esm",
        "types": [
            "vite/client"
        ],
        "paths": {
            "@cratis/scene.model/*": ["../model/dist/esm/*"],
            "@cratis/scene.engine/*": ["../engine/dist/esm/*"],
            "@cratis/scene.react/*": ["../react/dist/esm/*"],
            "@cratis/scene.design/*": ["../design/dist/esm/*"],
            "@cratis/scene.editor/*": ["../editor/dist/esm/*"]
        }
    },
    "files": [
        "../../../test.d.ts",
        "../../../global.d.ts",
        "global.d.ts"
    ],
    "include": [
        "**/*.ts",
        "**/*.tsx"
    ],
    "references": [
        { "path": "../model" },
        { "path": "../engine" },
        { "path": "../react" },
        { "path": "../design" },
        { "path": "../editor" }
    ],
    "exclude": [
        "dist",
        "vite.config.mts",
        "vitest.browser.config.mts",
        ".storybook"
    ]
}
