{
    "extends": "../../../tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "dist/esm",
        "paths": {
            "@cratis/scene.model/*": ["../model/dist/esm/*"],
            "@cratis/scene.engine/*": ["../engine/dist/esm/*"],
            "@cratis/scene.react/*": ["../react/dist/esm/*"],
            "@cratis/scene.primereact/*": ["../primereact/dist/esm/*"]
        }
    },
    "files": [
        "../../../test.d.ts",
        "../../../global.d.ts"
    ],
    "include": [
        "**/*.ts",
        "**/*.tsx"
    ],
    "references": [
        { "path": "../model" },
        { "path": "../engine" },
        { "path": "../react" },
        { "path": "../primereact" }
    ],
    "exclude": [
        "dist",
        "vite.config.mts",
        ".storybook"
    ]
}
