{
    "name": "@cratis/scene.blueprint.components",
    "version": "1.0.0",
    "description": "A blueprint of Arc-bound screen and dialog templates: full pages built from Cratis Components composites, so a data list, a command form or a master-detail screen is a template rather than something you assemble.",
    "author": "Cratis",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Scene.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "**/*.ts",
        "**/*.tsx"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/esm/index.d.ts",
            "require": "./dist/cjs/index.js",
            "import": "./dist/esm/index.js"
        }
    },
    "scripts": {
        "prepare": "yarn g:build",
        "clean": "yarn g:clean",
        "build": "yarn g:build",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "yarn g:test",
        "ci": "yarn g:ci",
        "up": "yarn g:up",
        "dev": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@cratis/components": "^2.8.1",
        "@cratis/scene.blueprint.default": "1.0.0",
        "@cratis/scene.components": "1.0.0",
        "@cratis/scene.engine": "1.0.0",
        "@cratis/scene.model": "1.0.0",
        "@cratis/scene.react": "1.0.0"
    },
    "devDependencies": {
        "@cratis/components": "^2.8.1",
        "@cratis/scene.blueprint.default": "1.0.0",
        "@cratis/scene.components": "1.0.0",
        "@cratis/scene.engine": "1.0.0",
        "@cratis/scene.model": "1.0.0",
        "@cratis/scene.react": "1.0.0",
        "@storybook/addon-links": "^10.4.1",
        "@storybook/react": "^10.4.1",
        "@storybook/react-vite": "^10.4.1",
        "primeicons": "^7.0.0",
        "primereact": "10.9.8",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "storybook": "^10.4.1"
    },
    "peerDependencies": {
        "primereact": "^10.9.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    }
}
