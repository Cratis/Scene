    {
      "name": "an own layout as the root template, with options",
      "library": "default",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "root": {
          "template": {
            "source": "Own",
            "id": "OwnShell"
          },
          "options": {
            "navigationMode": "slim",
            "showFooter": true
          }
        }
      },
      "expected": {
        "origin": "root",
        "kind": "layout",
        "source": "own",
        "name": "OwnShell",
        "reference": {
          "source": "Own",
          "id": "OwnShell"
        },
        "outlets": [
          "sidebar",
          "content"
