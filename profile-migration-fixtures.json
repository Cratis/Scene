  "cases": [
    {
      "name": "nothing legacy",
      "description": "a profile that is already in the new shape comes back unchanged",
      "legacy": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "core",
            "crm"
          ],
          "root": {
            "template": {
              "source": "blueprint",
              "id": "CrmShell",
              "blueprint": "crm",
              "version": "^1.4"
            },
            "options": {
              "navigationMode": "Sidebar"
            }
          },
          "appearance": {
            "colorScheme": "Dark"
          }
        }
      },
      "expected": {
        "profile": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"crm\"],\"root\":{\"template\":{\"source\":\"Blueprint\",\"id\":\"CrmShell\",\"blueprint\":\"crm\",\"version\":\"^1.4\"},\"options\":{\"navigationMode\":\"Sidebar\"}},\"appearance\":{\"colorScheme\":\"Dark\"}}",
        "changed": false,
        "diagnostics": []
      }
    },
    {
      "name": "no shell and no layout",
      "description": "no root, the Bare shell; nothing to migrate",
      "legacy": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "core",
            "crm"
          ]
        }
      },
      "expected": {
        "profile": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"crm\"]}",
        "changed": false,
        "diagnostics": []
      }
    },
    {
      "name": "own layout",
      "description": "a layout of the application becomes an own reference and the legacy layout name goes",
      "legacy": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "core",
            "crm"
          ],
          "layout": "OwnShell"
        }
      },
      "expected": {
        "profile": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"crm\"],\"root\":{\"template\":{\"source\":\"Own\",\"id\":\"OwnShell\"}}}",
        "changed": true,
        "diagnostics": []
      }
    },
    {
      "name": "blueprint layout from profile",
      "description": "a layout of an installed blueprint becomes a blueprint reference pinned to ^major.minor",
      "legacy": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "core",
            "crm"
          ],
          "layout": "CrmShell"
        }
      },
      "expected": {
        "profile": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"crm\"],\"root\":{\"template\":{\"source\":\"Blueprint\",\"id\":\"CrmShell\",\"blueprint\":\"crm\",\"version\":\"^1.4\"}}}",
        "changed": true,
        "diagnostics": []
      }
    },
    {
      "name": "shell and layout",
      "description": "the Studio shell names the blueprint, the layout the shell in it",
      "legacy": {
        "profile": {
          "name": "Desktop",
          "targetPlatform": "web",
          "packages": [
            "core",
            "hr"
          ],
          "layout": "HrShell"
        },
        "shell": "hr",
        "layout": "HrShell"
      },
      "expected": {
        "profile": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"hr\"],\"root\":{\"template\":{\"source\":\"Blueprint\",\"id\":\"HrShell\",\"blueprint\":\"hr\",\"version\":\"^2.0\"}}}",
        "changed": true,
        "diagnostics": []
      }
    },
    {
      "name": "shell only",
