    {
      "name": "duplicate ids keep the first declaration and are reported",
      "structure": {
        "modules": [
          {
            "id": "sales",
            "name": "Sales",
            "features": [
              {
                "id": "orders",
                "name": "Orders",
                "features": [],
                "slices": [
                  {
                    "id": "PlaceOrder",
                    "name": "Place order",
                    "kind": "StateChange"
                  },
                  {
                    "id": "PlaceOrder",
                    "name": "Place order again",
                    "kind": "StateView"
                  }
                ]
              },
              {
                "id": "orders",
                "name": "Orders again",
                "features": [],
                "slices": [
                  {
                    "id": "Hidden",
                    "name": "Hidden",
                    "kind": "StateChange"
                  }
                ]
              }
            ]
          },
          {
            "id": "sales",
            "name": "Sales again",
            "features": [
              {
                "id": "x",
                "name": "X",
                "features": [],
                "slices": []
              }
            ]
          }
        ]
      },
      "queries": [
        {
          "op": "findModule",
          "arg": "sales",
          "expected": "Sales"
        },
        {
          "op": "findFeature",
          "arg": "sales.orders",
          "expected": "Orders"
        },
        {
          "op": "findSlice",
          "arg": "sales.orders.PlaceOrder",
          "expected": "Place order"
        },
        {
          "op": "kindOf",
          "arg": "sales.orders.PlaceOrder",
          "expected": "StateChange"
        },
        {
          "op": "findSlice",
          "arg": "sales.orders.Hidden",
          "expected": null
        },
        {
          "op": "findFeature",
          "arg": "sales.x",
          "expected": null
        }
      ],
      "expectedDiagnostics": [
        {
          "code": "structureDuplicateId",
          "message": "Id 'sales.orders.PlaceOrder' is declared more than once; the first slice wins.",
          "id": "sales.orders.PlaceOrder"
        },
        {
          "code": "structureDuplicateId",
          "message": "Id 'sales.orders' is declared more than once; the first feature wins.",
          "id": "sales.orders"
        },
        {
          "code": "structureDuplicateId",
          "message": "Id 'sales' is declared more than once; the first module wins.",
          "id": "sales"
        }
      ]
    },
