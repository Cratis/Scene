{
  "description": "Shared application-structure lookup corpus asserted by both the C# engine (Engine.Specs/for_ApplicationStructureIndex) and the TypeScript engine (engine/for_applicationStructureIndex). Each query names an index operation, its argument and the expected result: a node's display name, a slice kind, a qualified id, a list of qualified ids, or null.",
  "cases": [
    {
      "name": "qualified lookup of modules, features and slices",
      "structure": {
        "modules": [
          {
            "id": "sales",
            "name": "Sales",
            "features": [
              {
                "id": "orders",
                "name": "Orders",
                "features": [
                  {
                    "id": "returns",
                    "name": "Returns",
                    "features": [],
                    "slices": [
                      {
                        "id": "CreateReturn",
                        "name": "Create return",
                        "kind": "StateChange"
                      }
                    ]
                  }
                ],
                "slices": [
                  {
                    "id": "PlaceOrder",
                    "name": "Place order",
                    "kind": "StateChange"
                  },
                  {
                    "id": "CancelOrder",
                    "name": "Cancel order",
                    "kind": "StateChange"
                  },
                  {
                    "id": "OrderSummary",
                    "name": "Order summary",
                    "kind": "StateView"
                  },
                  {
                    "id": "SendReminder",
                    "name": "Send reminder",
                    "kind": "Automation"
                  }
                ]
              },
              {
                "id": "customers",
                "name": "Customers",
                "features": [],
                "slices": [
                  {
                    "id": "CreateCustomer",
                    "name": "Create customer",
                    "kind": "StateChange"
                  }
                ]
              }
            ]
          },
          {
            "id": "support",
            "name": "Support",
            "features": [
              {
                "id": "tickets",
                "name": "Tickets",
                "features": [],
                "slices": [
                  {
                    "id": "AssignTicket",
                    "name": "Assign ticket",
                    "kind": "StateChange"
                  },
                  {
                    "id": "OpenTicketsView",
                    "name": "Open tickets",
                    "kind": "StateView"
                  }
                ]
              },
              {
                "id": "kb",
                "name": "Knowledge base",
                "features": [],
                "slices": []
              }
            ]
          }
        ]
      },
      "queries": [
        {
          "op": "findModule",
          "arg": "sales",
          "expected": "Sales"
        },
        {
          "op": "findModule",
          "arg": "support",
          "expected": "Support"
        },
        {
          "op": "findFeature",
          "arg": "sales.orders",
          "expected": "Orders"
        },
        {
          "op": "findFeature",
          "arg": "support.tickets",
          "expected": "Tickets"
        },
        {
          "op": "findSlice",
          "arg": "sales.orders.PlaceOrder",
          "expected": "Place order"
        },
        {
          "op": "findSlice",
          "arg": "support.tickets.AssignTicket",
          "expected": "Assign ticket"
        },
        {
          "op": "kindOf",
          "arg": "sales.orders.PlaceOrder",
          "expected": "StateChange"
        },
        {
          "op": "kindOf",
          "arg": "sales.orders.OrderSummary",
          "expected": "StateView"
        },
        {
          "op": "kindOf",
          "arg": "sales.orders.SendReminder",
          "expected": "Automation"
        }
      ],
      "expectedDiagnostics": []
    },
