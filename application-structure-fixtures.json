    {
      "name": "siblings that share a display name are ambiguous",
      "structure": {
        "modules": [
          {
            "id": "sales",
            "name": "Sales",
            "features": [
              {
                "id": "orders",
                "name": "Orders",
                "features": [],
                "slices": [
                  {
                    "id": "A",
                    "name": "Do it",
                    "kind": "StateChange"
                  },
                  {
                    "id": "B",
                    "name": "do it",
                    "kind": "StateChange"
                  }
                ]
              },
              {
                "id": "order-list",
                "name": "orders",
                "features": [],
                "slices": []
              }
            ]
          },
          {
            "id": "crm",
            "name": "sales",
            "features": []
          }
        ]
      },
      "queries": [
        {
          "op": "featuresByName",
          "arg": "ORDERS",
          "expected": [
            "sales.orders",
            "sales.order-list"
          ]
        }
      ],
      "expectedDiagnostics": [
        {
          "code": "structureAmbiguousName",
          "message": "The slice name 'do it' is used by both 'sales.orders.A' and 'sales.orders.B'.",
          "id": "sales.orders.B"
        },
        {
          "code": "structureAmbiguousName",
          "message": "The feature name 'orders' is used by both 'sales.orders' and 'sales.order-list'.",
          "id": "sales.order-list"
        },
        {
          "code": "structureAmbiguousName",
          "message": "The module name 'sales' is used by both 'sales' and 'crm'.",
          "id": "crm"
        }
      ]
    }
  ]
