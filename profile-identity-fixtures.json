{
  "description": "Shared by both engines: resolving the identity (name and logo) of a UI profile. A case with imageBytes has its logo image generated as a PNG data URI of that many zero bytes, so the corpus stays small; '$generated' stands for it.",
  "cases": [
    {
      "name": "no identity",
      "description": "a profile without an identity draws the host's name and its first letter",
      "hostName": "orders",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ]
      },
      "expected": {
        "name": "orders",
        "showName": true,
        "kind": "Initials",
        "initials": "O",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "no identity and no host name",
      "description": "an empty name falls back to A",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ]
      },
      "expected": {
        "name": "",
        "showName": true,
        "kind": "Initials",
        "initials": "A",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "name from the profile",
      "description": "the profile's name wins over the host's and is trimmed",
      "hostName": "orders",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "  Contoso "
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Initials",
        "initials": "C",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "explicit initials",
      "description": "initials are kept as typed",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "logo": {
            "kind": "Initials",
            "initials": "CO"
          }
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Initials",
        "initials": "CO",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "empty initials",
      "description": "empty initials mean the first letter of the name, upper-cased",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "contoso",
          "logo": {
            "kind": "Initials",
            "initials": ""
          }
        }
      },
      "expected": {
        "name": "contoso",
        "showName": true,
        "kind": "Initials",
        "initials": "C",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "initials too long",
      "description": "three characters are rejected, not truncated; the mark falls back to the name",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "logo": {
            "initials": "ABC"
          }
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Initials",
        "initials": "C",
        "imageMissing": false,
        "diagnostics": [
          {
            "code": "initialsTooLong",
            "message": "The initials 'ABC' are longer than 2 characters. Use at most 2."
          }
        ]
      }
    },
    {
      "name": "two astral characters",
      "description": "the limit counts characters, not UTF-16 units",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "x",
          "logo": {
            "initials": "😀😀"
          }
        }
      },
      "expected": {
        "name": "x",
        "showName": true,
        "kind": "Initials",
        "initials": "😀😀",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "name hidden",
      "description": "showName false hides the name beside the mark",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "showName": false
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": false,
        "kind": "Initials",
        "initials": "C",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "icon logo",
      "description": "an icon from the closed set",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "logo": {
            "kind": "Icon",
            "icon": "database"
          }
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Icon",
        "initials": "C",
        "icon": "database",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "every icon is accepted",
      "description": "the last icon of the set",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "logo": {
            "kind": "Icon",
            "icon": "palette",
            "initials": "ZZ"
          }
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Icon",
        "initials": "ZZ",
        "icon": "palette",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "unknown icon",
      "description": "an icon outside the set falls back to initials with a diagnostic",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "logo": {
            "kind": "Icon",
            "icon": "rocket"
          }
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Initials",
        "initials": "C",
        "imageMissing": false,
        "diagnostics": [
          {
            "code": "iconUnknown",
            "message": "The icon 'rocket' is not one of the logo icons: box, layers, home, users, receipt, package, database, palette."
          }
        ]
      }
    },
    {
      "name": "icon logo without an icon",
      "description": "an icon logo with no icon yet draws initials and is not an error",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "logo": {
            "kind": "Icon"
          }
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Initials",
        "initials": "C",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "image logo",
      "description": "a PNG data URI within the limit",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "logo": {
            "kind": "Image",
            "image": "data:image/png;base64,"
          }
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Image",
        "initials": "C",
        "image": "data:image/png;base64,",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "image logo without an image",
      "description": "valid to store, a profile problem, drawn as a dashed box",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "logo": {
            "kind": "Image"
          }
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Image",
        "initials": "C",
        "imageMissing": true,
        "diagnostics": []
      }
    },
    {
      "name": "image at the limit",
      "description": "exactly 400 KB is accepted",
      "hostName": "app",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "logo": {
            "kind": "Image",
            "image": "$generated"
          }
        }
      },
      "expected": {
        "name": "app",
        "showName": true,
        "kind": "Image",
        "initials": "A",
        "image": "$generated",
        "imageMissing": false,
        "diagnostics": []
      },
      "imageBytes": 409600
    },
    {
      "name": "image over the limit",
      "description": "one byte more than 400 KB is refused naming the limit",
      "hostName": "app",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "logo": {
            "kind": "Image",
            "image": "$generated"
          }
        }
      },
      "expected": {
        "name": "app",
        "showName": true,
        "kind": "Image",
        "initials": "A",
        "imageMissing": true,
        "diagnostics": [
          {
            "code": "imageTooLarge",
            "message": "The logo image is 401 KB. The limit is 400 KB."
          }
        ]
      },
      "imageBytes": 409603
    },
    {
      "name": "image of an unsupported type",
      "description": "a GIF is refused",
      "hostName": "app",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "logo": {
            "kind": "Image",
            "image": "data:image/gif;base64,R0lGODlh"
          }
        }
      },
      "expected": {
        "name": "app",
        "showName": true,
        "kind": "Image",
        "initials": "A",
        "imageMissing": true,
        "diagnostics": [
          {
            "code": "imageUnsupported",
            "message": "The logo image must be a PNG, JPG, SVG or WebP, stored as a base64 data URI."
          }
        ]
      }
    },
    {
      "name": "image that is not a data URI",
      "description": "a remote address is not stored inline",
      "hostName": "app",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "logo": {
            "kind": "Image",
            "image": "https://example.com/logo.png"
          }
        }
      },
      "expected": {
        "name": "app",
        "showName": true,
        "kind": "Image",
        "initials": "A",
        "imageMissing": true,
        "diagnostics": [
          {
            "code": "imageUnsupported",
            "message": "The logo image must be a PNG, JPG, SVG or WebP, stored as a base64 data URI."
          }
        ]
      }
    },
    {
      "name": "svg image",
      "description": "SVG is accepted",
      "hostName": "app",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "logo": {
            "kind": "Image",
            "image": "data:image/svg+xml;base64,PHN2Zy8+"
          }
        }
      },
      "expected": {
        "name": "app",
        "showName": true,
        "kind": "Image",
        "initials": "A",
        "image": "data:image/svg+xml;base64,PHN2Zy8+",
        "imageMissing": false,
        "diagnostics": []
      }
    },
    {
      "name": "other kinds' members are kept",
      "description": "switching the kind back shows what was entered before: initials stay while an image is the kind",
      "hostName": "",
      "profile": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core"
        ],
        "identity": {
          "name": "Contoso",
          "logo": {
            "kind": "Image",
            "initials": "CO",
            "icon": "box",
            "image": "data:image/svg+xml;base64,PHN2Zy8+"
          }
        }
      },
      "expected": {
        "name": "Contoso",
        "showName": true,
        "kind": "Image",
        "initials": "CO",
        "image": "data:image/svg+xml;base64,PHN2Zy8+",
        "imageMissing": false,
        "diagnostics": []
      }
    }
  ]
}
