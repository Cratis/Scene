            {
              "shape": "Cust",
              "readModel": "CustomerList"
            }
          ]
        },
        "root": {
          "template": {
            "id": "AppShell",
            "source": "Blueprint",
            "version": "^4.5",
            "blueprint": "Cratis.Blueprint.Default"
          },
          "options": {
            "showFooter": true,
            "navigationMode": "slim"
          }
        },
        "appearance": {
          "accent": "#4f46e5",
          "colorScheme": "Dark"
        },
        "defaults": {
          "newScreenTemplate": {
            "version": "^2.0",
            "blueprint": "crm",
            "id": "Workspace",
            "source": "Blueprint"
          }
        }
      },
      "canonical": "{\"name\":\"Contoso\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"Cratis.Components\",\"Cratis.Blueprint.Default\"],\"defaultSizeClass\":\"Regular\",\"layout\":\"Legacy\",\"theme\":\"Aurora\",\"sampleData\":{\"activePack\":\"crm-nordic-smb\",\"bindings\":[{\"pack\":\"crm-nordic\",\"target\":\"Customers\"}],\"mappings\":[{\"readModel\":\"CustomerList\",\"shape\":\"Cust\"}]},\"root\":{\"template\":{\"source\":\"Blueprint\",\"id\":\"AppShell\",\"blueprint\":\"Cratis.Blueprint.Default\",\"version\":\"^4.5\"},\"options\":{\"navigationMode\":\"slim\",\"showFooter\":true}},\"appearance\":{\"colorScheme\":\"Dark\",\"accent\":\"#4f46e5\"},\"defaults\":{\"newScreenTemplate\":{\"source\":\"Blueprint\",\"id\":\"Workspace\",\"blueprint\":\"crm\",\"version\":\"^2.0\"}}}"
