{
  "description": "Shared fixture corpus for the UiProfile JSON contract: reading (lenient) and writing (canonical) a profile must give identical bytes in the C# engine (UiProfileJson) and the TypeScript engine (parseUiProfile/serializeUiProfile). Canonical form: camelCase, enum values by declared name, absent members omitted, compact; key order is the model's declaration order for the profile, root template, template reference, appearance and defaults, ordinal order everywhere else. Part of Cratis/Scene#158.",
  "cases": [
    {
      "name": "no root, appearance or defaults",
      "description": "a profile written before the root template existed loads unchanged and writes back without the new members",
      "input": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core",
          "Cratis.Components"
        ]
      },
      "canonical": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"Cratis.Components\"]}"
    },
    {
      "name": "legacy layout only",
      "description": "Layout stays readable as the legacy shell name",
      "input": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core",
          "Cratis.Components"
        ],
        "layout": "AppShell",
        "theme": "Aurora",
        "defaultSizeClass": "Expanded"
      },
      "canonical": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"Cratis.Components\"],\"defaultSizeClass\":\"Expanded\",\"layout\":\"AppShell\",\"theme\":\"Aurora\"}"
    },
    {
      "name": "own root template",
      "description": "an own template, no pin",
      "input": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core",
          "Cratis.Components"
        ],
        "root": {
          "template": {
            "source": "Own",
            "id": "AppFrame"
          }
        }
      },
      "canonical": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"Cratis.Components\"],\"root\":{\"template\":{\"source\":\"Own\",\"id\":\"AppFrame\"}}}"
    },
    {
      "name": "blueprint root template with a version pin",
