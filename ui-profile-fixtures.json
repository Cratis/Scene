        ],
        "root": {
          "template": {
            "source": "Blueprint",
            "id": "AppShell",
            "blueprint": "Cratis.Blueprint.Default",
            "version": "^4.5"
          }
        }
      },
      "canonical": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"Cratis.Components\"],\"root\":{\"template\":{\"source\":\"Blueprint\",\"id\":\"AppShell\",\"blueprint\":\"Cratis.Blueprint.Default\",\"version\":\"^4.5\"}}}"
    },
    {
      "name": "root template with options",
      "description": "options are keyed by the shell's exposed option name and canonicalised by ordinal key order",
      "input": {
        "name": "Desktop",
        "targetPlatform": "web",
        "packages": [
          "core",
          "Cratis.Components"
        ],
        "root": {
          "template": {
            "source": "Blueprint",
            "id": "AppShell",
            "blueprint": "Cratis.Blueprint.Default",
            "version": "^4.5"
          },
          "options": {
            "showFooter": true,
            "navigationMode": "slim",
            "density": {
              "rows": 2,
              "compact": false
            },
            "tags": [
              "a",
              "b"
            ],
            "note": null
          }
        }
      },
      "canonical": "{\"name\":\"Desktop\",\"targetPlatform\":\"web\",\"packages\":[\"core\",\"Cratis.Components\"],\"root\":{\"template\":{\"source\":\"Blueprint\",\"id\":\"AppShell\",\"blueprint\":\"Cratis.Blueprint.Default\",\"version\":\"^4.5\"},\"options\":{\"density\":{\"compact\":false,\"rows\":2},\"navigationMode\":\"slim\",\"note\":null,\"showFooter\":true,\"tags\":[\"a\",\"b\"]}}}"
    },
