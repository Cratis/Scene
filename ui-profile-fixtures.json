    {
      "name": "everything with sample data",
      "description": "every member at once, with the sample-data selection kept and its keys ordered",
      "input": {
        "name": "Contoso",
        "targetPlatform": "web",
        "packages": [
          "core",
          "Cratis.Components",
          "Cratis.Blueprint.Default"
        ],
        "defaultSizeClass": "Regular",
        "layout": "Legacy",
        "theme": "Aurora",
        "sampleData": {
          "bindings": [
            {
              "target": "Customers",
              "pack": "crm-nordic"
