        "runDirectly": { "available": true, "missing": [], "reason": "Every input has a source" },
        "slots": [
          { "name": "detail", "role": "pane", "routed": false, "offered": true, "reason": "pane: free" }
        ]
      }
    },
    {
      "name": "a slot the page's content fills is refused",
      "request": {
        "slice": "Catalog.Products.EditProduct", "opens": "slot", "opensIn": "content", "screen": "EditProduct", "fits": ["page"],
        "inputs": [],
        "slots": [
          { "name": "content", "role": "page", "filled": true },
