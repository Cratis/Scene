        "reason": "Pane: the slice's first fit, and the page has room in 'detail'; it is routed, so opening it changes the URL",
        "runDirectly": { "available": true, "missing": [], "reason": "Every input has a source" },
        "slots": [
          { "name": "detail", "role": "pane", "routed": true, "offered": true, "reason": "pane, routed: opening here changes the URL", "route": { "slot": "detail", "parameters": [{ "name": "order", "value": "SO-7" }, { "name": "line" }], "segment": "approve-rma-request" } }
        ]
      }
