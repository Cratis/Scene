      "expected": {
        "requested": "dialog", "routed": false, "problem": "noScreen",
        "reason": "The slice has no screen, so it can only run directly",
        "runDirectly": { "available": true, "missing": [], "reason": "Every input has a source" },
        "slots": []
      }
    },
    {
