    {
      "name": "values in another letter case and an acronym in the slice name",
      "request": {
        "slice": "Sales.Returns.ApproveRMARequest", "opens": "Automatic", "screen": "ApproveRMARequest", "fits": ["PANE", "Dialog"],
        "inputs": [],
        "slots": [{ "name": "detail", "role": "Pane", "routed": true, "routedBy": ["order", "line"] }],
        "routeValues": { "order": "SO-7" }
      },
      "expected": {
