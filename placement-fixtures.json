        "slice": "Catalog.Products.SetProductPrice", "opens": "slot", "opensIn": "detail", "screen": "SetProductPrice", "fits": ["drawer", "pane", "dialog"],
        "inputs": [{ "name": "sku", "source": "component" }, { "name": "price" }],
        "slots": [
          { "name": "content", "role": "page", "filled": true },
