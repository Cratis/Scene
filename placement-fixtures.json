      "expected": {
        "requested": "slot", "routed": false, "problem": "noScreen",
        "reason": "The slice has no screen, so it can only run directly",
        "runDirectly": { "available": true, "missing": [], "reason": "Every input has a source" },
        "slots": [
          { "name": "detail", "role": "pane", "routed": false, "offered": false, "reason": "Not offered: the slice has no screen" }
        ]
      }
    },
    {
      "name": "a drawer the slice does not fit is refused",
      "request": {
        "slice": "Catalog.Products.DraftProduct", "opens": "drawer", "screen": "DraftProduct", "fits": ["dialog"],
        "inputs": [],
        "slots": []
      },
      "expected": {
        "requested": "drawer", "routed": false, "problem": "notFitted",
        "reason": "The slice doesn't list drawer in what it fits",
        "runDirectly": { "available": true, "missing": [], "reason": "Every input has a source" },
        "slots": []
      }
    },
    {
      "name": "a dialog chosen on the trigger",
      "request": {
        "slice": "Catalog.Products.DraftProduct", "opens": "dialog", "screen": "DraftProduct", "fits": ["dialog"],
        "inputs": [{ "name": "sku" }],
        "slots": []
      },
      "expected": {
        "requested": "dialog", "resolved": "dialog", "fit": "dialog", "routed": false,
        "reason": "Dialog: chosen on the trigger",
        "runDirectly": { "available": false, "missing": ["sku"], "reason": "sku has no source, so it needs the form" },
        "slots": []
      }
    },
    {
      "name": "automatic skips a fit the page has no room for",
