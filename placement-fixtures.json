{
  "description": "Placement, Opens and enablement of actions: where an action's slice opens and why (resolvePlacement / PlacementResolver.Resolve), whether it can be used and why (resolveEnablement / EnablementResolver.Resolve), and inspecting the actions of an outlet or an action component (inspectOutletActions, inspectActionElement / ActionInspector). The page of most cases is Products: content (a page the list fills), detail (a pane routed by sku) and activity (a free panel). Asserted by the TypeScript and C# engines.",
  "placement": [
    {
      "name": "automatic takes the slice's first fit, a drawer, which every page has",
      "request": {
        "slice": "Catalog.Products.SetProductPrice", "screen": "SetProductPrice", "fits": ["drawer", "pane", "dialog"],
        "inputs": [{ "name": "sku", "source": "component" }, { "name": "price" }],
        "slots": [
          { "name": "content", "role": "page", "filled": true },
          { "name": "detail", "role": "pane", "filled": true, "routed": true, "routedBy": ["sku"] },
          { "name": "activity", "role": "panel" }
        ],
        "routeValues": { "sku": "NK-101" }
      },
      "expected": {
        "requested": "automatic", "resolved": "drawer", "fit": "drawer", "routed": false,
        "reason": "Drawer: the slice's first fit, and the page has room",
        "runDirectly": { "available": false, "missing": ["price"], "reason": "price has no source, so it needs the form" },
        "slots": [
          { "name": "content", "role": "page", "routed": false, "offered": false, "reason": "Not offered: the slice doesn't list page in what it fits" },
          { "name": "detail", "role": "pane", "routed": true, "offered": true, "reason": "pane, routed: opening here changes the URL", "route": { "slot": "detail", "parameters": [{ "name": "sku", "value": "NK-101" }], "segment": "set-product-price" } },
          { "name": "activity", "role": "panel", "routed": false, "offered": false, "reason": "Not offered: the slice doesn't list panel in what it fits" }
        ]
      }
    },
    {
      "name": "run directly is refused when an input has no source",
      "request": {
        "slice": "Catalog.Products.SetProductPrice", "opens": "none", "screen": "SetProductPrice", "fits": ["drawer", "pane", "dialog"],
        "inputs": [{ "name": "sku", "source": "component" }, { "name": "price" }],
        "slots": []
      },
      "expected": {
        "requested": "none", "routed": false, "problem": "inputsWithoutSource",
        "reason": "price has no source, so it needs the form",
        "runDirectly": { "available": false, "missing": ["price"], "reason": "price has no source, so it needs the form" },
        "slots": []
      }
    },
    {
      "name": "run directly names every input without a source",
      "request": {
        "slice": "Catalog.Products.DraftProduct", "opens": "none", "screen": "DraftProduct", "fits": ["dialog"],
        "inputs": [{ "name": "sku" }, { "name": "name" }, { "name": "category", "source": "constant" }, { "name": "price" }],
        "slots": []
      },
      "expected": {
        "requested": "none", "routed": false, "problem": "inputsWithoutSource",
        "reason": "sku, name and price have no source, so they need the form",
        "runDirectly": { "available": false, "missing": ["sku", "name", "price"], "reason": "sku, name and price have no source, so they need the form" },
        "slots": []
      }
    },
    {
      "name": "run directly with two inputs without a source",
      "request": {
        "slice": "Catalog.Products.RenameProduct", "opens": "none", "screen": "RenameProduct", "fits": ["dialog"],
        "inputs": [{ "name": "sku", "source": "route" }, { "name": "name" }, { "name": "price" }],
        "slots": []
      },
      "expected": {
        "requested": "none", "routed": false, "problem": "inputsWithoutSource",
        "reason": "name and price have no source, so they need the form",
        "runDirectly": { "available": false, "missing": ["name", "price"], "reason": "name and price have no source, so they need the form" },
        "slots": []
      }
    },
    {
      "name": "run directly when every input has a source, even with a screen",
      "request": {
        "slice": "Catalog.Products.PublishProduct", "opens": "none", "screen": "PublishProduct", "fits": ["dialog"],
        "inputs": [{ "name": "sku", "source": "dataContext" }, { "name": "channel", "source": "constant" }],
        "slots": []
      },
      "expected": {
        "requested": "none", "resolved": "none", "routed": false,
        "reason": "Runs directly: every input has a source",
        "runDirectly": { "available": true, "missing": [], "reason": "Every input has a source" },
        "slots": []
      }
    },
    {
      "name": "a routed slot named on the trigger produces a URL",
