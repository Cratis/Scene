        "slots": [
          { "name": "content", "role": "page", "routed": false, "offered": false, "reason": "Not offered: it is already filled" },
          { "name": "activity", "role": "panel", "routed": false, "offered": false, "reason": "Not offered: it is already filled" }
        ]
      }
    },
    {
      "name": "automatic finds nothing when every slot the slice fits is full",
      "request": {
        "slice": "Catalog.Products.ShowProduct", "screen": "ShowProduct", "fits": ["panel", "page"],
        "inputs": [],
        "slots": [{ "name": "content", "role": "page", "filled": true }]
      },
      "expected": {
        "requested": "automatic", "routed": false, "problem": "nothingFits",
        "reason": "Nothing: the page has no free panel or page for the slice",
        "runDirectly": { "available": true, "missing": [], "reason": "Every input has a source" },
        "slots": [
          { "name": "content", "role": "page", "routed": false, "offered": false, "reason": "Not offered: it is already filled" }
        ]
      }
