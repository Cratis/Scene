  ],
  "enablement": [
    {
      "name": "an action with nothing to check",
      "request": {},
      "expected": { "state": "enabled", "reason": "Enabled", "steps": [] }
    },
    {
      "name": "an action for the screen",
      "request": { "subject": "screen" },
      "expected": { "state": "enabled", "reason": "Enabled", "steps": [] }
    },
    {
      "name": "an action for an item waits for a selection",
      "request": { "subject": "item", "selected": false },
      "expected": {
        "state": "disabled", "reason": "It is for item, so it waits for a selection",
        "steps": [{ "check": "subject", "outcome": "blocked", "reason": "It is for item, so it waits for a selection" }]
      }
    },
    {
      "name": "an action for an item with one selected",
      "request": { "subject": "Item", "selected": true },
      "expected": {
        "state": "enabled", "reason": "Enabled",
        "steps": [{ "check": "subject", "outcome": "passed", "reason": "An item is selected" }]
      }
    },
    {
      "name": "a persona without the command's policy does not see the action",
      "request": { "authorize": "ManageCatalog", "persona": { "name": "Viewer", "policies": ["ReadCatalog"] } },
      "expected": {
        "state": "hidden", "reason": "Viewer does not have 'ManageCatalog', which the command authorizes with",
        "steps": [{ "check": "authorization", "outcome": "blocked", "reason": "Viewer does not have 'ManageCatalog', which the command authorizes with" }]
      }
    },
    {
      "name": "a persona with the command's policy",
      "request": { "authorize": "ManageCatalog", "persona": { "name": "Catalog manager", "policies": ["ManageCatalog"] } },
      "expected": {
        "state": "enabled", "reason": "Enabled",
        "steps": [{ "check": "authorization", "outcome": "passed", "reason": "Catalog manager has 'ManageCatalog'" }]
      }
    },
    {
      "name": "authorization with no persona to check it against",
      "request": { "authorize": "ManageCatalog" },
      "expected": {
        "state": "enabled", "reason": "Enabled",
        "steps": [{ "check": "authorization", "outcome": "unchecked", "reason": "The command authorizes with 'ManageCatalog', and no persona is given to check it against" }]
      }
    },
    {
      "name": "a condition the host says does not hold",
      "request": { "enabledWhen": "item.status == \"onSale\"", "conditionHolds": false },
      "expected": {
        "state": "disabled", "reason": "Enabled when item.status == \"onSale\", which does not hold",
        "steps": [{ "check": "condition", "outcome": "blocked", "reason": "Enabled when item.status == \"onSale\", which does not hold" }]
      }
    },
    {
      "name": "a structured condition evaluated against the selected item",
      "request": {
        "subject": "item", "selected": true, "item": { "status": "onSale" },
        "enabledWhen": "item.status == \"onSale\"",
        "condition": { "kind": "comparison", "left": { "subject": "item.status" }, "operator": "Equal", "right": "onSale" }
      },
      "expected": {
        "state": "enabled", "reason": "Enabled",
        "steps": [
          { "check": "subject", "outcome": "passed", "reason": "An item is selected" },
          { "check": "condition", "outcome": "passed", "reason": "item.status == \"onSale\" holds" }
        ]
      }
    },
    {
      "name": "a structured condition that does not hold for the selected item",
      "request": {
        "subject": "item", "selected": true, "item": { "status": "draft" },
        "enabledWhen": "item.status == \"onSale\"",
        "condition": { "kind": "comparison", "left": { "subject": "item.status" }, "operator": "Equal", "right": "onSale" }
      },
      "expected": {
        "state": "disabled", "reason": "Enabled when item.status == \"onSale\", which does not hold",
        "steps": [
          { "check": "subject", "outcome": "passed", "reason": "An item is selected" },
          { "check": "condition", "outcome": "blocked", "reason": "Enabled when item.status == \"onSale\", which does not hold" }
        ]
      }
    },
    {
      "name": "a condition with nothing to evaluate it against",
      "request": { "enabledWhen": "item.status == \"onSale\"" },
      "expected": {
        "state": "enabled", "reason": "Enabled",
        "steps": [{ "check": "condition", "outcome": "unchecked", "reason": "Enabled when item.status == \"onSale\", which cannot be checked here" }]
      }
    },
    {
      "name": "enabled when as written is evaluated against the selected item",
      "request": { "subject": "item", "selected": true, "item": { "status": "onSale", "stock": 4 }, "enabledWhen": "item.status == \"onSale\" and item.stock > 0" },
      "expected": {
        "state": "enabled", "reason": "Enabled",
        "steps": [
          { "check": "subject", "outcome": "passed", "reason": "An item is selected" },
          { "check": "condition", "outcome": "passed", "reason": "item.status == \"onSale\" and item.stock > 0 holds" }
        ]
      }
    },
    {
      "name": "enabled when that does not hold names the part that fails",
      "request": { "subject": "item", "selected": true, "item": { "status": "onSale", "stock": 0 }, "enabledWhen": "item.status == \"onSale\" && (item.stock > 0 || item.backorder == true)" },
      "expected": {
