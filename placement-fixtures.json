        "slots": []
      }
    },
    {
      "name": "a slot the page does not declare is refused",
      "request": {
        "slice": "Catalog.Products.SetProductPrice", "opens": "slot", "opensIn": "sidebar", "screen": "SetProductPrice", "fits": ["pane"],
