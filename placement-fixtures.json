        "reason": "Dialog: the screen lists no fits, so it opens in a dialog",
        "runDirectly": { "available": true, "missing": [], "reason": "Every input has a source" },
        "slots": [
          { "name": "detail", "role": "pane", "routed": false, "offered": false, "reason": "Not offered: the slice doesn't list pane in what it fits" }
        ]
