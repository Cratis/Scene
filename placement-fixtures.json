        "slice": "Catalog.Products.ShowProduct", "screen": "ShowProduct", "fits": ["panel", "pane", "dialog"],
        "inputs": [{ "name": "sku", "source": "component" }],
        "slots": [
          { "name": "content", "role": "page", "filled": true },
          { "name": "detail", "role": "pane", "filled": true, "routed": true, "routedBy": ["sku"] }
        ]
      },
      "expected": {
        "requested": "automatic", "resolved": "slot", "fit": "pane", "slot": "detail", "routed": true,
        "route": { "slot": "detail", "parameters": [{ "name": "sku" }], "segment": "show-product" },
        "reason": "Pane: the slice's second fit, since the page has no free panel; it opens in 'detail'; it is routed, so opening it changes the URL",
        "runDirectly": { "available": true, "missing": [], "reason": "Every input has a source" },
        "slots": [
          { "name": "content", "role": "page", "routed": false, "offered": false, "reason": "Not offered: the slice doesn't list page in what it fits" },
          { "name": "detail", "role": "pane", "routed": true, "offered": true, "reason": "pane, routed: opening here changes the URL", "route": { "slot": "detail", "parameters": [{ "name": "sku" }], "segment": "show-product" } }
        ]
      }
    },
    {
      "name": "automatic falls back to a dialog after the slots it fits are full",
