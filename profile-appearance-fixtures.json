{
  "description": "Shared by both engines: resolving the appearance of a UI profile into effective tokens.",
  "cases": [
    {
      "name": "nothing set",
      "description": "a light theme and no appearance changes nothing",
      "theme": {
        "name": "L",
        "compatibleWith": [
          "core"
        ],
        "isDark": false,
        "tokens": {
          "primary.color": "#4f46e5",
          "content.borderRadius": "0.5rem",
          "focus.ring": "0 0 0 2px rgb(79 70 229 / 0.4)",
          "text.color": "#111111"
        }
      },
      "appearance": null,
      "systemIsDark": false,
      "availableFonts": null,
      "expected": {
        "colorScheme": "Light",
        "tokens": {
          "primary.color": "#4f46e5",
          "content.borderRadius": "0.5rem",
          "focus.ring": "0 0 0 2px rgb(79 70 229 / 0.4)",
          "text.color": "#111111"
        },
        "diagnostics": []
      }
    },
